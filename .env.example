# Copy to .env (never commit .env). The OpenAI client reads these two directly.
OPENAI_API_KEY=your-class-proxy-key
OPENAI_BASE_URL=https://your-class-proxy/v1

CHAT_MODEL=gemma-4-E4B-it
EMBED_PROVIDER=local                     # local | openai | tfidf
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHUNK_STRATEGY=clause                    # clause (Article/clause-aware) | window (naive baseline)
CHUNK_WORDS=150                          # set from the chunk-size sweep
CHUNK_OVERLAP=25
TOP_K=5
CANDIDATE_POOL=20
MIN_SCORE=0.40                           # chosen from the min_score sweep (see evaluation/results/ANALYSIS.md)
MAX_STEPS=5
HYDE=1                                   # HyDE query expansion; keep only if the eval shows it helps
